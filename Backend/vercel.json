{
    "version": 2,
    "buildCommand": "npm run build",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ],
    "functions": {
        "api/index.ts": {
            "includeFiles": "node_modules/.prisma/client/**",
            "memory": 1024,
            "maxDuration": 60
        }
    }
}
