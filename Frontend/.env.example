# ==============================================================================
# Mandatory Backend & Real-Time Endpoints
# ==============================================================================
# Base URL for the NestJS REST API (MUST include the /api/v1 prefix)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Base origin for the Socket.IO WebSocket server (DO NOT include /api/v1 or trailing slash)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ==============================================================================
# Institutional Tenant & Identity Configuration
# ==============================================================================
# College identifier code matching the backend database tenant (e.g., SDIET, AIT)
NEXT_PUBLIC_COLLEGE_SHORT_CODE=SDIET

# Official name of the college for display & document generation
NEXT_PUBLIC_COLLEGE_NAME="Satyug Darshan Institute of Engineering and Technology"

# ==============================================================================
# Optional / Feature Flags
# ==============================================================================
# Disable test/demo mocks and guest access in production
NEXT_PUBLIC_DEMO_MODE=false
