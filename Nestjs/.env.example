# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Database / Redis ─────────────────────────────────
DATABASE_URL=postgresql://college:college@localhost:5432/college_os?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth (generate with: openssl rand -base64 48) ────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Rate limiting ────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ── AI (provider-agnostic) ───────────────────────────
# openai | gemini | openrouter | local
AI_PROVIDER=openai
AI_BASE_URL=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Storage ──────────────────────────────────────────
# local | s3 | r2
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads-dev
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Seed (dev only; never use in production) ─────────
SEED_ADMIN_PASSWORD=

# ── Email / notifications ────────────────────────────
APP_URL=http://localhost:5173
SMTP_URL=
MAIL_FROM=College OS <no-reply@college.local>
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
PUSH_PROVIDER_KEY=
MAX_UPLOAD_MB=20
# Dev seed only (seed refuses to run when NODE_ENV=production)
SEED_PASSWORD=
